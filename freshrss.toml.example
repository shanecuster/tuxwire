# tuxwire FreshRSS sync — docs/ARCHITECTURE.md § FreshRSS Sync (optional).
#
# Optional, and off by default. Only takes effect at all when tuxwire was
# built with `cargo build --features freshrss` *and* this file (copied to
# ~/.config/tuxwire/freshrss.toml) has enabled = true -- either gate alone
# is enough to guarantee zero behavior change and zero network requests.
#
# This exact file is also compiled directly into the tuxwire binary
# (src/freshrss/config.rs) as the fallback used when
# ~/.config/tuxwire/freshrss.toml doesn't exist yet -- unlike sources.toml,
# that fallback is never written out to disk, since most people running
# tuxwire will never turn this feature on at all.

[freshrss]
enabled       = false
url           = "https://freshrss.example.com"   # base URL only, no /api/greader.php
username      = "your-username"

# Whether to sync in the background automatically when tuxwire starts, in
# addition to pressing `r` while a FreshRSS/* topic is selected. Defaults
# to true when this key is left out entirely.
sync_on_start = true

# The most items any *one* sync will fetch full contents for and store,
# even if more unread items than this are waiting on the server. Defaults
# to 500 when left out. A first sync against an account with thousands of
# unread items backfills gradually across several syncs rather than
# trying to pull everything in a single pass. Must be between 1 and
# 10,000 -- tuxwire will refuse to start with a clear error otherwise.
max_items_per_sync = 500

# Whether a sync is allowed to send anything back to the server -- marking
# items read remotely (via edit-tag) when you've read them locally.
# Defaults to true. Setting this to false doesn't touch the pull
# direction: the server's own read state still flows in locally, this
# only stops tuxwire from ever writing back to your FreshRSS account --
# for a read-only mirror of your reading list.
push_read_state = true

# The API password is set under your FreshRSS profile (separate from your
# account login password) and never goes in this file. Provide it one of
# two ways:
#   1. password_file: path to a file containing only the API password
#      (chmod 600 -- tuxwire will warn if it's readable by group/others),
#      or
#   2. the TUXWIRE_FRESHRSS_PASSWORD environment variable, which takes
#      precedence over password_file when both are set.
password_file = "~/.config/tuxwire/freshrss.pass"
