# tuxwire sync -- docs/ARCHITECTURE.md § Optional CouchDB sync.
#
# OPTIONAL. Copy this file to ~/.config/tuxwire/sync.toml and fill it in only
# if you want your saved articles and notes copied to a CouchDB server that
# YOU run, so your devices share them. Without this file (or with
# `enabled = false`) tuxwire never touches the network for sync.
#
# What is synced: saved articles and their notes. Read/unread is not synced.
#
# Run a sync with `tuxwire sync` (or press `c` in the reader). Check the
# settings without sending anything with `tuxwire sync --test`.
#
# THE PASSWORD NEVER GOES IN THIS FILE. tuxwire refuses to start if it finds a
# `password` line here. Give it one of two ways:
#   1. the environment variable TUXWIRE_SYNC_PASSWORD (checked first), or
#   2. `password_file` below: a file holding only the password, readable by
#      you alone (`chmod 600 FILE`). tuxwire refuses a password file that
#      other users on this computer could read.
#
# Do not commit this file to a public repository: the address of your server
# is private.

[sync]
# Sync is off until you set this to true.
enabled = false

# Your server's address. Must start with https:// (plain http:// is only
# accepted for this computer itself: localhost, 127.0.0.1 or ::1). Do not put
# a username or password in the address.
url = "https://couch.example.net"

# The database to use. tuxwire never creates databases; make it first.
database = "tuxwire"

# The login name for that database.
username = "tuxwire"

# Optional: where the password file is (`~` means your home directory).
# Not needed if you use TUXWIRE_SYNC_PASSWORD instead.
# password_file = "~/.config/tuxwire/sync-password"

# Optional, and a SEPARATE switch (off unless you write `true`): also mirror
# your FEED LIST, so a feed added on your phone appears here and the other way
# round. Your feed addresses are sent to your server only if you turn this on,
# and it only works while `enabled = true` above.
#
#   - Feeds another device added are added to your feed list file.
#   - Feeds another device removed are NEVER removed on their own. `tuxwire sync`
#     asks y/N for each one, and a yes only turns the feed's block in your list
#     file into `#` comments (so you can bring it back). Run from something that
#     is not a terminal, it lists them and removes nothing. `c` in the reader
#     only says how many are waiting.
#   - Renames, topic changes and Reddit sources are not synced.
# feeds = false

# Which feed list (see lists.toml) to mirror. Without this line, the first one.
# feed_list = "main"

# Optional, and a SEPARATE switch (off unless you write `true`): also share
# WHICH ARTICLES YOU HAVE OPENED, so an article you read on your phone shows as
# read here and the other way round. This records what you read, so it has its
# own switch. The address of each opened article is sent to your server only if
# you turn this on, and it only works while `enabled = true` above.
#
#   - Only articles opened in the last 90 days are sent; older reads stay as
#     they are on each device. Nothing is ever deleted from your server.
#   - Reading is one way: an article can be opened, never marked unread again.
#   - If the other device opened an article this one has not downloaded yet,
#     it is marked read when it arrives.
# read_marks = false
