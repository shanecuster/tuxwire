# tuxwire export — docs/ARCHITECTURE.md § Markdown Export.
#
# Copy this file to ~/.config/tuxwire/export.toml and edit freely -- the
# `E` keybind (Saved view) always writes here, never prompts interactively,
# same "config-driven, no per-export prompt" approach as sources.toml and
# theme.toml.
#
# This exact file is also compiled directly into the tuxwire binary
# (src/export.rs) and is written out to ~/.config/tuxwire/export.toml the
# first time an export runs and finds no config there yet, so a first `E`
# press always has somewhere real to write to.
#
# rclone isn't set up yet, so this isn't pointed at a synced folder for
# now -- repoint at one later by editing this single line once it is.
# `~` is expanded to $HOME; the directory is created automatically if it
# doesn't exist yet.

# The file has two sections: saved articles that have no note (a short list)
# first, then the articles that have notes, each with its note in full.
# Set include_unnoted = false to export only the notes. (If you leave the line
# out, everything saved is exported.)

[export]
path = "~/tuxwire-notes/"
include_unnoted = true
