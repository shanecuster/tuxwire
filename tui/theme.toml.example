# tuxwire theme (docs/ARCHITECTURE.md § theme.toml, src/theme.rs).
#
# Copy this file to ~/.config/tuxwire/theme.toml, or just press `t` in
# tuxwire: the theme picker writes it for you the first time you keep a
# theme. This exact file is also compiled into the tuxwire binary as the
# default used before ~/.config/tuxwire/theme.toml exists.

# The built-in theme to start from. One of:
#   "Everforest" (default), "Dracula", "Gruvbox", "Catppuccin Mocha",
#   "Nord", "Solarized Dark", "Tokyo Night", "Catppuccin Macchiato"
# The `t` picker rewrites only this line, so your comments and the
# overrides below are kept.
base = "Everforest"

# Optional overrides. Any color set here replaces the built-in theme's
# color for that slot, whichever built-in is selected above. Leave a line
# commented out to use the built-in's color. Colors are "#rrggbb".
#
# A theme.toml from before the picker existed (all eleven lines set, no
# `base`) keeps working exactly as before. Since every slot is overridden,
# though, switching built-ins in the picker won't visibly change anything
# until you comment some of these out.
[theme]
# background   = "#2d353b"  # whole-app background
# panel_border = "#475258"  # box borders
# text_primary = "#d3c6aa"  # normal text
# text_muted   = "#859289"  # meta lines, hints, footer
# text_dim     = "#56635f"  # reserved for skipped text

# accent_unread   = "#e69875"  # unread / new titles, banner
# accent_read     = "#83c092"  # read titles
# accent_skipped  = "#d699b6"  # skipped titles
# accent_saved    = "#dbbc7f"  # saved titles, note previews
# accent_breaking = "#e67e80"  # errors
# accent_selected = "#7fbbb3"  # selected row, key labels, popup borders
